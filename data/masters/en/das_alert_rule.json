{
  "key": "das_alert_rule",
  "name": "Data Access Security Alert Rule",
  "description": "Sent to the recipients on a Data Access Security alert rule that notifies by email, once per activity that matches it. Email is throttled per rule, so a burst of matches may not produce one email each.",
  "medium": "EMAIL",
  "tenantLocale": "en",
  "language": "en",
  "from": "$__global.emailFromAddress",
  "replyTo": "$__global.emailFromAddress",
  "subject": "Alert triggered by the $alert.ruleName alert rule",
  "body": "<h2 style=\"margin:0 0 16px 0;font-family:Calibri,Arial,sans-serif;font-size:20px;font-weight:bold;color:__ISC_BRAND_NAVIGATION_COLOR__;\">Data Access Security Alert</h2>\n<p style=\"margin:0 0 12px 0;font-family:Calibri,Arial,sans-serif;font-size:14px;line-height:1.5;color:#333333;\">Dear $__recipient.name,</p>\n<p style=\"margin:0 0 16px 0;font-family:Calibri,Arial,sans-serif;font-size:14px;line-height:1.5;color:#333333;\">A <strong style=\"color:__ISC_BRAND_ACTION_COLOR__;\">$alert.severity</strong> severity alert was triggered by the <strong>$alert.ruleName</strong> alert rule.</p>\n<p style=\"margin:0 0 8px 0;font-family:Calibri,Arial,sans-serif;font-size:14px;line-height:1.5;color:#333333;\"><strong>Alert details</strong></p>\n<div style=\"margin:0 0 16px 0;padding:12px 16px;border-left:4px solid __ISC_BRAND_ACTION_COLOR__;background-color:#f7f7f7;\">\n<p style=\"margin:0 0 6px 0;font-family:Calibri,Arial,sans-serif;font-size:14px;line-height:1.5;color:#333333;\"><strong style=\"color:__ISC_BRAND_NAVIGATION_COLOR__;\">Action Time:</strong> $alert.actionTime</p>\n<p style=\"margin:0 0 6px 0;font-family:Calibri,Arial,sans-serif;font-size:14px;line-height:1.5;color:#333333;\"><strong style=\"color:__ISC_BRAND_NAVIGATION_COLOR__;\">User Name:</strong> $alert.userName</p>\n<p style=\"margin:0 0 6px 0;font-family:Calibri,Arial,sans-serif;font-size:14px;line-height:1.5;color:#333333;\"><strong style=\"color:__ISC_BRAND_NAVIGATION_COLOR__;\">Identity Name:</strong> $alert.identityName</p>\n<p style=\"margin:0 0 6px 0;font-family:Calibri,Arial,sans-serif;font-size:14px;line-height:1.5;color:#333333;\"><strong style=\"color:__ISC_BRAND_NAVIGATION_COLOR__;\">Department:</strong> $alert.identityDepartment</p>\n<p style=\"margin:0 0 6px 0;font-family:Calibri,Arial,sans-serif;font-size:14px;line-height:1.5;color:#333333;\"><strong style=\"color:__ISC_BRAND_NAVIGATION_COLOR__;\">Action Type:</strong> $alert.actionType</p>\n<p style=\"margin:0 0 6px 0;font-family:Calibri,Arial,sans-serif;font-size:14px;line-height:1.5;color:#333333;\"><strong style=\"color:__ISC_BRAND_NAVIGATION_COLOR__;\">Application:</strong> $alert.application</p>\n<p style=\"margin:0 0 6px 0;font-family:Calibri,Arial,sans-serif;font-size:14px;line-height:1.5;color:#333333;\"><strong style=\"color:__ISC_BRAND_NAVIGATION_COLOR__;\">Resource Path:</strong> $alert.resourcePath</p>\n<p style=\"margin:0 0 6px 0;font-family:Calibri,Arial,sans-serif;font-size:14px;line-height:1.5;color:#333333;\"><strong style=\"color:__ISC_BRAND_NAVIGATION_COLOR__;\">Object Name:</strong> $alert.objectName</p>\n<p style=\"margin:0;font-family:Calibri,Arial,sans-serif;font-size:14px;line-height:1.5;color:#333333;\"><strong style=\"color:__ISC_BRAND_NAVIGATION_COLOR__;\">Data Classification Policies:</strong> $alert.dataClassificationPolicies</p>\n</div>\n<p style=\"margin:0 0 16px 0;font-family:Calibri,Arial,sans-serif;font-size:14px;line-height:1.5;color:#333333;\">Click <a href=\"$alert.url\" style=\"color:__ISC_BRAND_ACTION_COLOR__;text-decoration:underline;\">here</a> to open the Activity Forensics page and review related alerts for this rule.</p>\n<p style=\"margin:0 0 8px 0;font-family:Calibri,Arial,sans-serif;font-size:14px;line-height:1.5;color:#333333;\">Thank you,<br/><strong>The SailPoint Team</strong></p>\n<p style=\"margin:0;font-family:Calibri,Arial,sans-serif;font-size:11px;line-height:1.4;color:#666666;\">This is an automatic message from <strong>Data Access Security</strong>. Please do not reply.</p>",
  "origin": "cursor-redesign",
  "sourceDigest": "d55a5c5edc902365123168d786ff7535575ca3d6dd2b6aa6d3b0b5a5b8320ffa"
}