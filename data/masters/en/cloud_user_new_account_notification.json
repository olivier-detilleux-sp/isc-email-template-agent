{
  "key": "cloud_user_new_account_notification",
  "name": "New Account Provisioned",
  "description": "Sent to a user when an account is created on a source for them.",
  "medium": "EMAIL",
  "tenantLocale": "en",
  "language": "en",
  "from": "$__global.emailFromAddress",
  "replyTo": "$__global.emailFromAddress",
  "subject": "${source} — New account created for ${username}",
  "body": "<h2 style=\"margin:0 0 16px 0;font-family:Arial,Helvetica,sans-serif;font-size:22px;line-height:1.3;color:__ISC_BRAND_NAVIGATION_COLOR__;\">New account provisioned</h2>\n<p style=\"margin:0 0 12px 0;font-family:Arial,Helvetica,sans-serif;font-size:14px;line-height:1.5;color:#333333;\">Hello,</p>\n<p style=\"margin:0 0 16px 0;font-family:Arial,Helvetica,sans-serif;font-size:14px;line-height:1.5;color:#333333;\">The ${PRODUCT_NAME} system has created an account for ${username} on the ${source} source. Account details are below.</p>\n<div style=\"margin:0 0 16px 0;padding:12px 16px;border-left:4px solid __ISC_BRAND_ACTION_COLOR__;background-color:#f5f7fa;\">\n<p style=\"margin:0 0 8px 0;font-family:Arial,Helvetica,sans-serif;font-size:14px;line-height:1.5;color:#333333;\"><strong style=\"color:__ISC_BRAND_NAVIGATION_COLOR__;\">User name:</strong> ${accountUserName}</p>\n<p style=\"margin:0 0 8px 0;font-family:Arial,Helvetica,sans-serif;font-size:14px;line-height:1.5;color:#333333;\"><strong style=\"color:__ISC_BRAND_NAVIGATION_COLOR__;\">Access:</strong></p>\n<ul style=\"margin:0;padding:0 0 0 20px;font-family:Arial,Helvetica,sans-serif;font-size:14px;line-height:1.5;color:#333333;\">\n#foreach ($access in $accountAccess)\n<li style=\"margin:0 0 4px 0;\">$access</li>\n#end\n</ul>\n</div>\n<p style=\"margin:0 0 16px 0;font-family:Arial,Helvetica,sans-serif;font-size:14px;line-height:1.5;color:#333333;\">If you have any questions, contact your administrator.</p>\n<p style=\"margin:0;font-family:Arial,Helvetica,sans-serif;font-size:14px;line-height:1.5;color:#333333;\">Thank you,<br/>The ${PRODUCT_NAME} Team</p>",
  "origin": "cursor-redesign",
  "sourceDigest": "ab3437aecd421adc2d152844b0d79da17d830753ec0a54f55672124eb4f6d029"
}