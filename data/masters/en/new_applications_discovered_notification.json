{
  "key": "new_applications_discovered_notification",
  "name": "New Applications Discovered",
  "description": "Notify source owners that new applications have been discovered from a discovery source.",
  "medium": "EMAIL",
  "tenantLocale": "en",
  "language": "en",
  "from": "$__global.emailFromAddress",
  "replyTo": "$__global.emailFromAddress",
  "subject": "$AppCount new applications discovered from $DiscoverySourceName",
  "body": "<h2 style=\"margin:0 0 16px 0;font-size:20px;line-height:1.3;color:__ISC_BRAND_NAVIGATION_COLOR__;\">New applications discovered</h2>\n<p style=\"margin:0 0 12px 0;font-size:14px;line-height:1.5;color:#333333;\">Dear $__recipient.name,</p>\n<p style=\"margin:0 0 16px 0;font-size:14px;line-height:1.5;color:#333333;\">$AppCount new applications were discovered from the <strong style=\"color:__ISC_BRAND_NAVIGATION_COLOR__;\">$DiscoverySourceName</strong> discovery source.</p>\n<div style=\"margin:0 0 16px 0;padding:12px 16px;border-left:4px solid __ISC_BRAND_ACTION_COLOR__;background-color:#f5f7fa;\">\n<p style=\"margin:0 0 8px 0;font-size:13px;line-height:1.4;color:#333333;\"><strong>Discovered applications</strong></p>\n<table style=\"width:100%;border-collapse:collapse;font-size:13px;line-height:1.4;color:#333333;\">\n<tr>\n<th style=\"text-align:left;padding:8px;border-bottom:2px solid __ISC_BRAND_NAVIGATION_COLOR__;color:__ISC_BRAND_NAVIGATION_COLOR__;\">Application</th>\n<th style=\"text-align:left;padding:8px;border-bottom:2px solid __ISC_BRAND_NAVIGATION_COLOR__;color:__ISC_BRAND_NAVIGATION_COLOR__;\">Discovery source</th>\n<th style=\"text-align:left;padding:8px;border-bottom:2px solid __ISC_BRAND_NAVIGATION_COLOR__;color:__ISC_BRAND_NAVIGATION_COLOR__;\">Discovery source type</th>\n</tr>\n#foreach($app in $AppNames)\n<tr>\n<td style=\"padding:8px;border-bottom:1px solid #e0e0e0;\">$app</td>\n<td style=\"padding:8px;border-bottom:1px solid #e0e0e0;\">$DiscoverySourceName</td>\n<td style=\"padding:8px;border-bottom:1px solid #e0e0e0;\">$DiscoverySource</td>\n</tr>\n#end\n</table>\n</div>\n<p style=\"margin:0 0 16px 0;font-size:14px;line-height:1.5;color:#333333;\">View the <a href=\"${__global.productUrl}${DeepLinkSuffix}\" style=\"color:__ISC_BRAND_ACTION_COLOR__;text-decoration:underline;\">discovered applications</a>.</p>\n<p style=\"margin:0;font-size:14px;line-height:1.5;color:#333333;\">Thank you,<br/>The $__global.productName Team</p>",
  "origin": "cursor-redesign",
  "sourceDigest": "0d6cef79217d127c56247ccdd3a2d443231d341caafcca5770f6193b51e521a3"
}