{
  "key": "source_config_collab_revoke_user_level",
  "name": "Remove Assignee User Level",
  "description": "Notifies an administrator to remove Source Configuration Assignee user level.",
  "medium": "EMAIL",
  "tenantLocale": "en",
  "language": "en",
  "from": "$__global.emailFromAddress",
  "replyTo": "$__global.emailFromAddress",
  "subject": "$requesterUser requests that you revoke the Source Configuration Assignee user level from $user",
  "body": "<h2 style=\"margin:0 0 16px 0;font-family:Arial,Helvetica,sans-serif;font-size:20px;line-height:1.3;color:__ISC_BRAND_NAVIGATION_COLOR__;\">Remove Source Configuration Assignee User Level</h2>\n<p style=\"margin:0 0 12px 0;font-family:Arial,Helvetica,sans-serif;font-size:14px;line-height:1.5;color:#333333;\">Dear $adminUser,</p>\n<p style=\"margin:0 0 16px 0;font-family:Arial,Helvetica,sans-serif;font-size:14px;line-height:1.5;color:#333333;\">$requesterUser has requested that the Source Configuration Assignee user level be removed from $user because they have finished onboarding their assigned sources.</p>\n<div style=\"margin:0 0 16px 0;padding:12px 16px;border-left:4px solid __ISC_BRAND_ACTION_COLOR__;background-color:#f5f7fa;\">\n<p style=\"margin:0 0 8px 0;font-family:Arial,Helvetica,sans-serif;font-size:14px;line-height:1.5;color:#333333;\"><strong style=\"color:__ISC_BRAND_NAVIGATION_COLOR__;\">Requested by</strong><br>$requesterUser</p>\n<p style=\"margin:0;font-family:Arial,Helvetica,sans-serif;font-size:14px;line-height:1.5;color:#333333;\"><strong style=\"color:__ISC_BRAND_NAVIGATION_COLOR__;\">Identity to update</strong><br>$user</p>\n</div>\n<p style=\"margin:0 0 16px 0;font-family:Arial,Helvetica,sans-serif;font-size:14px;line-height:1.5;color:#333333;\">To revoke this user level, open their <a href=\"$userLink\" style=\"color:__ISC_BRAND_ACTION_COLOR__;text-decoration:underline;\">identity</a> and remove the Source Configuration Assignee <a href=\"https://documentation.sailpoint.com/saas/help/accounts/identities.html#setting-user-level-permissions\" style=\"color:__ISC_BRAND_ACTION_COLOR__;text-decoration:underline;\">user level</a>.</p>\n<p style=\"margin:0;font-family:Arial,Helvetica,sans-serif;font-size:14px;line-height:1.5;color:#333333;\">Thank you,<br>The $__global.productName Team</p>",
  "origin": "cursor-redesign",
  "sourceDigest": "8e225dd29cc4896ff5de4db1e0912c3f1c14fd66f54cbe9e74045c261431417b"
}