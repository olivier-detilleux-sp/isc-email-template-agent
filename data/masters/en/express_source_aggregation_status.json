{
  "key": "express_source_aggregation_status",
  "name": "Express source aggregation status",
  "description": "Notifies when Express source aggregation is completed.",
  "medium": "EMAIL",
  "tenantLocale": "en",
  "language": "en",
  "from": "$__global.emailFromAddress",
  "replyTo": "$__global.emailFromAddress",
  "subject": "Source aggregation for $SOURCE_NAME #if($TASK_STATUS.equalsIgnoreCase(\"Error\"))failed#{else}completed#end",
  "body": "#set($url=$__global.productUrl + '/ui/a/admin/connections/sources-list')#if($TASK_STATUS.equalsIgnoreCase(\"Error\"))<h2 style=\"margin:0 0 16px 0;font-family:Arial,Helvetica,sans-serif;font-size:20px;line-height:28px;color:__ISC_BRAND_NAVIGATION_COLOR__;font-weight:bold;\">Source aggregation failed</h2><p style=\"margin:0 0 12px 0;font-family:Arial,Helvetica,sans-serif;font-size:14px;line-height:20px;color:#333333;\">Dear recipient,</p><p style=\"margin:0 0 12px 0;font-family:Arial,Helvetica,sans-serif;font-size:14px;line-height:20px;color:#333333;\">The source aggregation for <b>$SOURCE_NAME</b> failed on <b>$COMPLETED_DATE</b>.</p><div style=\"border-left:4px solid __ISC_BRAND_ACTION_COLOR__;background-color:#f7f7f7;padding:12px 16px;margin:0 0 16px 0;\"><p style=\"margin:0;font-family:Arial,Helvetica,sans-serif;font-size:14px;line-height:20px;color:#333333;\"><b>Status:</b> $TASK_STATUS</p></div><p style=\"margin:0 0 16px 0;font-family:Arial,Helvetica,sans-serif;font-size:14px;line-height:20px;color:#333333;\">Go to the <a href=\"$url\" style=\"color:__ISC_BRAND_ACTION_COLOR__;text-decoration:underline;\">Sources</a> page to view the source details.</p><p style=\"margin:0;font-family:Arial,Helvetica,sans-serif;font-size:14px;line-height:20px;color:#333333;\">Thank you,<br/>The $__global.productName Team</p>#{else}<h2 style=\"margin:0 0 16px 0;font-family:Arial,Helvetica,sans-serif;font-size:20px;line-height:28px;color:__ISC_BRAND_NAVIGATION_COLOR__;font-weight:bold;\">Source aggregation completed</h2><p style=\"margin:0 0 12px 0;font-family:Arial,Helvetica,sans-serif;font-size:14px;line-height:20px;color:#333333;\">Dear recipient,</p><p style=\"margin:0 0 12px 0;font-family:Arial,Helvetica,sans-serif;font-size:14px;line-height:20px;color:#333333;\">The source aggregation for <b>$SOURCE_NAME</b> completed on <b>$COMPLETED_DATE</b>.</p><div style=\"border-left:4px solid __ISC_BRAND_ACTION_COLOR__;background-color:#f7f7f7;padding:12px 16px;margin:0 0 16px 0;\"><ul style=\"margin:0;padding:0 0 0 18px;font-family:Arial,Helvetica,sans-serif;font-size:14px;line-height:22px;color:#333333;\"><li style=\"margin:0 0 6px 0;\"><b>Status:</b> $TASK_STATUS</li><li style=\"margin:0;\"><b>Total aggregated objects:</b> $TOTAL_AGGREGATED_OBJECTS</li></ul></div><p style=\"margin:0 0 16px 0;font-family:Arial,Helvetica,sans-serif;font-size:14px;line-height:20px;color:#333333;\">Go to the <a href=\"$url\" style=\"color:__ISC_BRAND_ACTION_COLOR__;text-decoration:underline;\">Sources</a> page to view the source details.</p><p style=\"margin:0;font-family:Arial,Helvetica,sans-serif;font-size:14px;line-height:20px;color:#333333;\">Thank you,<br/>The $__global.productName Team</p>#end",
