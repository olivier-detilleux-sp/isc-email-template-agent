{
  "key": "cloud_user_password_expiration",
  "name": "Password Expiration",
  "description": "Sent when a user's password is about to expire or has expired.",
  "medium": "EMAIL",
  "tenantLocale": "en",
  "language": "en",
  "from": "$__global.emailFromAddress",
  "replyTo": "$__global.emailFromAddress",
  "subject": "Reminder: Your ${acctName} password#if ( ${dayToExpire} <= 0 ) has expired#elseif ( ${dayToExpire} == 1 ) expires in ${dayToExpire} day#elseif ( ${dayToExpire} > 1 ) expires in ${dayToExpire} days#end",
  "body": "<h2 style=\"margin:0 0 16px 0;font-family:Arial,Helvetica,sans-serif;font-size:20px;line-height:1.3;color:__ISC_BRAND_NAVIGATION_COLOR__;\">Password Expiration Notice</h2>\n<p style=\"margin:0 0 12px 0;font-family:Arial,Helvetica,sans-serif;font-size:14px;line-height:1.5;color:#333333;\">Hi ${user.name},</p>\n#if ( ${dayToExpire} <= 0 )\n<div style=\"margin:0 0 16px 0;padding:12px 16px;border-left:4px solid __ISC_BRAND_ACTION_COLOR__;background-color:#f7f7f7;font-family:Arial,Helvetica,sans-serif;font-size:14px;line-height:1.5;color:#333333;\">Your ${acctName} password has expired.</div>\n#elseif ( ${dayToExpire} == 1 )\n<div style=\"margin:0 0 16px 0;padding:12px 16px;border-left:4px solid __ISC_BRAND_ACTION_COLOR__;background-color:#f7f7f7;font-family:Arial,Helvetica,sans-serif;font-size:14px;line-height:1.5;color:#333333;\">Your ${acctName} password expires in ${dayToExpire} day.</div>\n#{else}\n<div style=\"margin:0 0 16px 0;padding:12px 16px;border-left:4px solid __ISC_BRAND_ACTION_COLOR__;background-color:#f7f7f7;font-family:Arial,Helvetica,sans-serif;font-size:14px;line-height:1.5;color:#333333;\">Your ${acctName} password expires in ${dayToExpire} days.</div>\n#end\n<p style=\"margin:0 0 12px 0;font-family:Arial,Helvetica,sans-serif;font-size:14px;line-height:1.5;color:#333333;\">Select <a href=\"$resetUrl\" style=\"color:__ISC_BRAND_ACTION_COLOR__;text-decoration:underline;\">here</a> to change or reset your password.</p>\n<p style=\"margin:0 0 16px 0;font-family:Arial,Helvetica,sans-serif;font-size:14px;line-height:1.5;color:#333333;\">If that link does not work, copy and paste the following URL into your browser:<br/><span style=\"word-break:break-all;color:__ISC_BRAND_NAVIGATION_COLOR__;\">${resetUrl}</span></p>\n#if (${applist})\n#if (${appCount} > 1)\n<p style=\"margin:0 0 8px 0;font-family:Arial,Helvetica,sans-serif;font-size:14px;line-height:1.5;color:#333333;\">The following applications use ${acctName} password for SSO:</p>\n#{else}\n<p style=\"margin:0 0 8px 0;font-family:Arial,Helvetica,sans-serif;font-size:14px;line-height:1.5;color:#333333;\">The following application uses ${acctName} password for SSO:</p>\n#end\n<div style=\"margin:0 0 16px 0;padding:12px 16px;border-left:4px solid __ISC_BRAND_NAVIGATION_COLOR__;background-color:#f7f7f7;font-family:Arial,Helvetica,sans-serif;font-size:14px;line-height:1.5;color:#333333;\">${applist}</div>\n#end\n<p style=\"margin:24px 0 0 0;font-family:Arial,Helvetica,sans-serif;font-size:14px;line-height:1.5;color:#333333;\">Thank you,<br/>The ${PRODUCT_NAME} Team</p>",
  "origin": "cursor-redesign",
  "sourceDigest": "ea64f95c2bb1309f159d1de52310e36ef598c8a5f0caff0155b57bd722d778a8"
}