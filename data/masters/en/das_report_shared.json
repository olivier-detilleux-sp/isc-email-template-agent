  "body": "<h2 style=\"margin:0 0 16px 0;font-family:Arial,Helvetica,sans-serif;font-size:20px;font-weight:bold;color:__ISC_BRAND_NAVIGATION_COLOR__;\">Data Access Security report shared</h2>\n<p style=\"margin:0 0 12px 0;font-family:Arial,Helvetica,sans-serif;font-size:14px;line-height:1.5;color:#333333;\">Hello,</p>\n<p style=\"margin:0 0 16px 0;font-family:Arial,Helvetica,sans-serif;font-size:14px;line-height:1.5;color:#333333;\"><a href=\"mailto:$reportShare.senderEmail\" style=\"color:__ISC_BRAND_ACTION_COLOR__;text-decoration:underline;\">$reportShare.senderName</a> has shared the following report(s) with you:</p>\n<div style=\"margin:0 0 16px 0;padding:12px 16px;border-left:4px solid __ISC_BRAND_NAVIGATION_COLOR__;background-color:#f5f7fa;font-family:Arial,Helvetica,sans-serif;font-size:14px;line-height:1.5;color:#333333;\">$reportShare.reportList</div>\n<div style=\"margin:0 0 16px 0;padding:12px 16px;border-left:4px solid __ISC_BRAND_ACTION_COLOR__;background-color:#fafafa;font-family:Arial,Helvetica,sans-serif;font-size:14px;line-height:1.5;color:#333333;\">$reportShare.personalMessage</div>\n<p style=\"margin:0 0 16px 0;font-family:Arial,Helvetica,sans-serif;font-size:13px;line-height:1.5;color:#555555;\">This email is intended only for you. Please do not forward it.</p>\n<p style=\"margin:0;font-family:Arial,Helvetica,sans-serif;font-size:12px;line-height:1.5;color:#666666;\">This is an automated message from <strong>Data Access Security</strong>. Please do not reply.</p>",
