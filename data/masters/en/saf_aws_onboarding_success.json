{
  "key": "saf_aws_onboarding_success",
  "name": "SAF AWS Onboarding – Completed Successfully",
  "description": "Sent to the user when SAF AWS Onboarding completes successfully.",
  "medium": "EMAIL",
  "tenantLocale": "en",
  "language": "en",
  "from": "$__global.emailFromAddress",
  "replyTo": "$__global.emailFromAddress",
  "subject": "SAF AWS Onboarding completed successfully",
  "body": "<h2 style=\"margin:0 0 16px 0;font-family:'Helvetica Neue',Helvetica,Arial,sans-serif;font-size:22px;font-weight:600;color:__ISC_BRAND_NAVIGATION_COLOR__;line-height:1.3;\">SAF AWS Onboarding completed successfully</h2>\n<p style=\"margin:0 0 16px 0;font-family:'Helvetica Neue',Helvetica,Arial,sans-serif;font-size:14px;color:#333333;line-height:1.6;\">Dear $__recipient.name,</p>\n<div style=\"font-family:'Helvetica Neue',Helvetica,Arial,sans-serif;background-color:#F3FBF7;border-left:4px solid __ISC_BRAND_ACTION_COLOR__;padding:16px 20px;margin:0 0 24px 0;border-radius:4px;\">\n<p style=\"margin:0 0 8px 0;font-size:16px;font-weight:600;color:__ISC_BRAND_ACTION_COLOR__;\">Your AWS onboarding is complete</p>\n<p style=\"margin:0;font-size:14px;color:#444444;line-height:1.6;\">SailPoint has deployed the required resources, configured the AWS SaaS Connector, and created your new source in Identity Security Cloud.</p>\n</div>\n<p style=\"margin:0 0 10px 0;font-family:'Helvetica Neue',Helvetica,Arial,sans-serif;font-size:15px;font-weight:600;color:__ISC_BRAND_NAVIGATION_COLOR__;\">Onboarding summary</p>\n<table style=\"width:100%;border-collapse:collapse;margin:0 0 24px 0;font-family:'Helvetica Neue',Helvetica,Arial,sans-serif;font-size:14px;\">\n<tbody>\n<tr>\n<td style=\"padding:10px 15px;border-bottom:1px solid #EEEEEE;color:#666666;width:40%;\">Source Name</td>\n<td style=\"padding:10px 15px;border-bottom:1px solid #EEEEEE;font-weight:bold;color:#222222;\">$sourceName</td>\n</tr>\n<tr>\n<td style=\"padding:10px 15px;border-bottom:1px solid #EEEEEE;color:#666666;\">Source ID</td>\n<td style=\"padding:10px 15px;border-bottom:1px solid #EEEEEE;font-family:monospace;color:#555555;\">$sourceId</td>\n</tr>\n#if($adminAccountId)\n<tr>\n<td style=\"padding:10px 15px;border-bottom:1px solid #EEEEEE;color:#666666;\">AWS Management Account</td>\n<td style=\"padding:10px 15px;border-bottom:1px solid #EEEEEE;font-family:monospace;color:#555555;\">$adminAccountId</td>\n</tr>\n#end\n#if($totalAccounts != $null)\n<tr>\n<td style=\"padding:10px 15px;border-bottom:1px solid #EEEEEE;color:#666666;\">Total Accounts</td>\n<td style=\"padding:10px 15px;border-bottom:1px solid #EEEEEE;font-weight:bold;color:#222222;\">$!totalAccounts</td>\n</tr>\n#end\n<tr>\n<td style=\"padding:10px 15px;border-bottom:1px solid #EEEEEE;color:#666666;\">Deployment Status</td>\n<td style=\"padding:10px 15px;border-bottom:1px solid #EEEEEE;color:__ISC_BRAND_ACTION_COLOR__;font-weight:bold;\">Fully completed</td>\n</tr>\n</tbody>\n</table>\n<p style=\"margin:0 0 10px 0;font-family:'Helvetica Neue',Helvetica,Arial,sans-serif;font-size:15px;font-weight:600;color:__ISC_BRAND_NAVIGATION_COLOR__;\">Account deployment details</p>\n<table style=\"width:100%;border-collapse:collapse;margin:0 0 24px 0;font-family:'Helvetica Neue',Helvetica,Arial,sans-serif;font-size:14px;\">\n<tbody>\n<tr>\n<td style=\"padding:10px 15px;border:1px solid #EEEEEE;color:#666666;width:40%;\">Management Account</td>\n<td style=\"padding:10px 15px;border:1px solid #EEEEEE;font-weight:bold;color:#222222;\"><span style=\"color:__ISC_BRAND_ACTION_COLOR__;\">Deployed successfully</span></td>\n</tr>\n#if($childAccountsTotal != $null && $childAccountsTotal > 0)\n<tr>\n<td style=\"padding:10px 15px;border:1px solid #EEEEEE;color:#666666;width:40%;\">Child Accounts</td>\n<td style=\"padding:10px 15px;border:1px solid #EEEEEE;font-weight:bold;color:#222222;\"><span style=\"color:__ISC_BRAND_ACTION_COLOR__;\">Deployed successfully ($!childAccountsTotal accounts)</span></td>\n</tr>\n#end\n</tbody>\n</table>\n<p style=\"margin:0 0 10px 0;font-family:'Helvetica Neue',Helvetica,Arial,sans-serif;font-size:15px;font-weight:600;color:__ISC_BRAND_NAVIGATION_COLOR__;\">What was completed</p>\n<ul style=\"margin:0 0 24px 0;padding-left:20px;font-family:'Helvetica Neue',Helvetica,Arial,sans-serif;font-size:14px;color:#555555;line-height:1.8;\">\n<li>AWS onboarding CloudFormation resources deployed successfully</li>\n<li>AWS SaaS Connector configured with secure delegation roles</li>\n<li>SailPoint Identity Security Cloud source created and initialized</li>\n<li>Initial automated connectivity validation completed successfully</li>\n</ul>\n<p style=\"margin:0 0 16px 0;font-family:'Helvetica Neue',Helvetica,Arial,sans-serif;font-size:14px;color:#555555;line-height:1.6;\">You can now view your AWS source in SailPoint Identity Security Cloud.</p>\n#set($url=$__global.productUrl + '/ui/a/admin/connections/sources/' + $sourceId)\n<div style=\"margin:0 0 24px 0;\">\n<a href=\"$url\" style=\"background-color:__ISC_BRAND_ACTION_COLOR__;color:#FFFFFF;text-decoration:none;padding:12px 24px;border-radius:4px;font-weight:bold;font-size:14px;display:inline-block;font-family:'Helvetica Neue',Helvetica,Arial,sans-serif;\">View Source in SailPoint</a>\n</div>\n<div style=\"font-family:'Helvetica Neue',Helvetica,Arial,sans-serif;border-left:3px solid __ISC_BRAND_NAVIGATION_COLOR__;padding:8px 0 8px 12px;margin:0 0 20px 0;\">\n<p style=\"margin:0;font-size:13px;color:#666666;line-height:1.6;font-style:italic;\"><strong style=\"font-style:normal;color:#333333;\">Important:</strong> If Agentic Fabric has already been activated for this AWS source, you cannot make onboarding changes through SAF. To troubleshoot or make configuration changes, go to the underlying AWS source in Identity Security Cloud (ISC).</p>\n</div>\n<p style=\"margin:0 0 24px 0;font-family:'Helvetica Neue',Helvetica,Arial,sans-serif;font-size:14px;color:#555555;line-height:1.6;\">For detailed deployment and onboarding status, including account-level success or failure details, sign in to your AWS account and review the AWS onboarding logs.</p>\n<p style=\"margin:0;font-family:'Helvetica Neue',Helvetica,Arial,sans-serif;font-size:14px;color:#555555;line-height:1.6;\">Thank you for using SailPoint Identity Security Cloud.</p>",
  "origin": "cursor-redesign",
  "sourceDigest": "bdd1829f16a968df3b10b251eb988a7a05b2fca99473d1a200df3c6a07bb5fa6"
}