{
  "key": "account_deletion_request_completed",
  "name": "Account Deletion Request Completed",
  "description": "Sent to a requester to confirm that their account delete request has been completed successfully.",
  "medium": "EMAIL",
  "tenantLocale": "en",
  "language": "en",
  "from": "$__global.emailFromAddress",
  "replyTo": "$__global.emailFromAddress",
  "subject": "$data.sourceName – $data.operationType request completed successfully for $data.accountName",
  "body": "<h2 style=\"color: __ISC_BRAND_NAVIGATION_COLOR__; font-family: Arial, Helvetica, sans-serif; font-size: 20px; font-weight: bold; margin: 0 0 16px 0;\">Account deletion request completed</h2>\n<p style=\"font-family: Arial, Helvetica, sans-serif; font-size: 14px; line-height: 1.5; color: #333333; margin: 0 0 12px 0;\">Hello $data.requesterName,</p>\n<p style=\"font-family: Arial, Helvetica, sans-serif; font-size: 14px; line-height: 1.5; color: #333333; margin: 0 0 16px 0;\">Your request to $data.operationType.toLowerCase() account $data.accountName on $data.sourceName was completed successfully.</p>\n<div style=\"border-left: 4px solid __ISC_BRAND_ACTION_COLOR__; background-color: #f5f7fa; padding: 12px 16px; margin: 0 0 16px 0;\">\n<p style=\"font-family: Arial, Helvetica, sans-serif; font-size: 14px; line-height: 1.5; color: #333333; margin: 0 0 8px 0;\"><strong style=\"color: __ISC_BRAND_NAVIGATION_COLOR__;\">Request details</strong></p>\n<ul style=\"font-family: Arial, Helvetica, sans-serif; font-size: 14px; line-height: 1.5; color: #333333; margin: 0; padding-left: 20px;\">\n<li style=\"margin-bottom: 6px;\">Account: $data.accountName</li>\n<li style=\"margin-bottom: 0;\">Source: $data.sourceName</li>\n</ul>\n</div>\n<p style=\"font-family: Arial, Helvetica, sans-serif; font-size: 14px; line-height: 1.5; color: #333333; margin: 0 0 16px 0;\">The account has been removed from the source.</p>\n<p style=\"font-family: Arial, Helvetica, sans-serif; font-size: 14px; line-height: 1.5; color: #333333; margin: 0;\">Thank you,<br/>The $__global.productName Team</p>",
  "origin": "cursor-redesign",
  "sourceDigest": "0eec628bf1d479c7d7258b4e5602692c3b2e81d3b605af5fc625aa043833e5f4"
