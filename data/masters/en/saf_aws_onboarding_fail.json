  "body": "<h2 style=\"margin:0 0 16px 0;font-family:'Helvetica Neue',Helvetica,Arial,sans-serif;font-size:22px;font-weight:600;color:__ISC_BRAND_NAVIGATION_COLOR__;\">SAF AWS Onboarding Failed</h2>\n<p style=\"margin:0 0 16px 0;font-family:'Helvetica Neue',Helvetica,Arial,sans-serif;font-size:14px;line-height:1.6;color:#333333;\">Dear $__recipient.name,</p>\n<p style=\"margin:0 0 20px 0;font-family:'Helvetica Neue',Helvetica,Arial,sans-serif;font-size:14px;line-height:1.6;color:#333333;\">We were unable to complete the Rapid AWS Onboarding process. As a result, no active AWS source was created in SailPoint Identity Security Cloud.</p>\n<div style=\"background-color:#FDF2F2;border-left:4px solid __ISC_BRAND_ACTION_COLOR__;padding:14px 18px;margin:0 0 24px 0;border-radius:4px;\">\n<p style=\"margin:0;font-family:'Helvetica Neue',Helvetica,Arial,sans-serif;font-size:14px;line-height:1.6;color:#444444;\"><strong style=\"color:__ISC_BRAND_ACTION_COLOR__;\">AWS onboarding could not be completed.</strong> Please review the summary and failure details below before you try again.</p>\n</div>\n<table style=\"width:100%;border-collapse:collapse;margin:0 0 24px 0;font-family:'Helvetica Neue',Helvetica,Arial,sans-serif;font-size:14px;\">\n<thead>\n<tr style=\"background-color:#F8F9FA;\">\n<th colspan=\"2\" style=\"text-align:left;padding:10px 15px;border-bottom:2px solid __ISC_BRAND_NAVIGATION_COLOR__;font-weight:600;color:__ISC_BRAND_NAVIGATION_COLOR__;\">Onboarding summary</th>\n</tr>\n</thead>\n<tbody>\n#if($sourceId)\n<tr>\n<td style=\"padding:10px 15px;border-bottom:1px solid #EEEEEE;color:#666666;\">Source ID</td>\n<td style=\"padding:10px 15px;border-bottom:1px solid #EEEEEE;font-family:monospace;color:#555555;\">$sourceId</td>\n</tr>\n#end\n#if($adminAccountId)\n<tr>\n<td style=\"padding:10px 15px;border-bottom:1px solid #EEEEEE;color:#666666;\">AWS Management Account</td>\n<td style=\"padding:10px 15px;border-bottom:1px solid #EEEEEE;font-family:monospace;color:#555555;\">$adminAccountId</td>\n</tr>\n#end\n<tr>\n<td style=\"padding:10px 15px;border-bottom:1px solid #EEEEEE;color:#666666;\">Deployment status</td>\n<td style=\"padding:10px 15px;border-bottom:1px solid #EEEEEE;color:__ISC_BRAND_ACTION_COLOR__;font-weight:bold;\">Failed</td>\n</tr>\n</tbody>\n</table>\n#if($failureReason)\n<div style=\"background-color:#F8F9FA;border:1px solid #EEEEEE;border-left:4px solid __ISC_BRAND_ACTION_COLOR__;padding:15px;border-radius:4px;margin:0 0 24px 0;\">\n<p style=\"margin:0 0 6px 0;font-family:'Helvetica Neue',Helvetica,Arial,sans-serif;font-size:14px;font-weight:600;color:__ISC_BRAND_NAVIGATION_COLOR__;\">Failure details</p>\n<p style=\"margin:0;font-family:monospace;font-size:13px;line-height:1.5;color:__ISC_BRAND_ACTION_COLOR__;\">$failureReason</p>\n</div>\n#end\n<p style=\"margin:0 0 8px 0;font-family:'Helvetica Neue',Helvetica,Arial,sans-serif;font-size:15px;font-weight:600;color:__ISC_BRAND_NAVIGATION_COLOR__;\">Recommended actions</p>\n<p style=\"margin:0 0 12px 0;font-family:'Helvetica Neue',Helvetica,Arial,sans-serif;font-size:14px;line-height:1.6;color:#555555;\">Please verify your AWS configuration before retrying. Common failure causes include:</p>\n<ul style=\"margin:0 0 20px 0;padding-left:20px;font-family:'Helvetica Neue',Helvetica,Arial,sans-serif;font-size:14px;line-height:1.8;color:#555555;\">\n<li>Delegation access request rejected or timed out in the AWS Management Account</li>\n<li>CloudFormation StackSet creation or instance deployment failures</li>\n<li>Insufficient AWS IAM administrator permissions or organization policy restrictions</li>\n<li>Invalid deployment account ID or incorrect configuration values</li>\n</ul>\n<p style=\"margin:0 0 24px 0;font-family:'Helvetica Neue',Helvetica,Arial,sans-serif;font-size:14px;line-height:1.6;color:#555555;\">For detailed deployment and onboarding status, including account-level success or failure details, sign in to your AWS account and review the AWS onboarding logs.</p>\n<p style=\"margin:0;font-family:'Helvetica Neue',Helvetica,Arial,sans-serif;font-size:14px;line-height:1.6;color:#555555;\">Thank you for using SailPoint Identity Security Cloud.</p>",
  "origin": "cursor-redesign",
  "sourceDigest": "f8420e8e6695ff631624dda90a022ede181fba71edcbc94fd9e4d7788af47088"
}