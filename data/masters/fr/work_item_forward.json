  "body": "<h2 style=\"color: __ISC_BRAND_NAVIGATION_COLOR__; margin: 0 0 16px 0; font-size: 20px; font-weight: 600;\">Élément de travail transféré</h2>\n<p style=\"margin: 0 0 16px 0; font-size: 14px; line-height: 1.5; color: #333333;\">$requester a transféré l'élément de travail « $workItemName ».</p>\n<div style=\"border-left: 4px solid __ISC_BRAND_ACTION_COLOR__; padding: 12px 16px; margin: 0 0 16px 0; background-color: #f5f5f5;\">\n<p style=\"margin: 0 0 8px 0; font-size: 14px; line-height: 1.5; color: #333333;\"><strong style=\"color: __ISC_BRAND_NAVIGATION_COLOR__;\">De :</strong> $previousOwner</p>\n<p style=\"margin: 0 0 8px 0; font-size: 14px; line-height: 1.5; color: #333333;\"><strong style=\"color: __ISC_BRAND_NAVIGATION_COLOR__;\">À :</strong> $newOwner</p>\n<p style=\"margin: 0; font-size: 14px; line-height: 1.5; color: #333333;\"><strong style=\"color: __ISC_BRAND_NAVIGATION_COLOR__;\">Date :</strong> $spTools.formatDate($forwardDate,3,1)</p>\n</div>\n<p style=\"margin: 0 0 8px 0; font-size: 14px; line-height: 1.5; color: #333333;\">Informations complémentaires :</p>\n<p style=\"margin: 0 0 24px 0; font-size: 14px; line-height: 1.5; color: #333333;\">$!commentText</p>\n<p style=\"margin: 0; font-size: 14px; line-height: 1.5; color: #333333;\">Cordialement,</p>",
